# RustVNC 部署环境变量模板
#
# 使用方式：
#   cp .env.example .env
#   chmod 600 .env
#   编辑 .env，填入自己的域名与密钥
#
# 不要把 .env 提交到版本库。示例中的域名和密钥全部是占位符。

# ---------------------------------------------------------------------------
# 域名（需要提前配置 DNS A/AAAA 记录）
# ---------------------------------------------------------------------------
BASE_DOMAIN=example.com
RVNC_DOMAIN=rvnc.example.com
HEADSCALE_DOMAIN=headscale.example.com
DERP_DOMAIN=derp.example.com

# Let's Encrypt 账户邮箱
ACME_EMAIL=admin@example.com

# ---------------------------------------------------------------------------
# DERP
# ---------------------------------------------------------------------------
# 单机部署时 Caddy 已占用 443，因此 derper 默认发布到宿主机 8443。
# 若 derper 使用独立公网 IP/独立主机，可改为 443。
DERP_HTTPS_PORT=8443

# manual: 使用 deploy/derp/certs 下的证书文件（推荐与 Caddy 同机部署）
# letsencrypt: 由 derper 自己申请证书（必须独占 80/443，不能位于代理之后）
DERP_CERTMODE=manual

# 必须与 headscale/config.yaml 的 derp.urls 一致，并包含外部端口
DERP_URL=https://derp.example.com:8443

# ---------------------------------------------------------------------------
# 配对后台（rv-server）
# ---------------------------------------------------------------------------
# 管理员令牌：至少 32 字节随机值，例如 `openssl rand -hex 32` 生成 64 个十六进制字符。
# 严禁保留 CHANGE_ME：服务启动时会对短于 16 字符的令牌发出警告。
RV_ADMIN_TOKEN=CHANGE_ME

# 可选：监听端口（容器内部固定 8080，无需修改）
# AGENT_PORT=21416
# TOKEN_TTL_DAYS=30

# ---------------------------------------------------------------------------
# Headscale
# ---------------------------------------------------------------------------
# 用户 ID：执行 `docker compose exec headscale headscale users list` 获取
HEADSCALE_USER=1

# API Key：执行 `docker compose exec headscale headscale apikeys create --expiration 90d` 获取。
# 首次部署请保持为空，先只启动 headscale，创建 Key 后再回填并启动其余服务；
# 这样 rv-server 首次启动时会正确写入数据库。
# rv-server 用它调用 POST /api/v1/preauthkey 与 GET /api/v1/node。
# 注意：该值会以明文保存在 rv-server 的 SQLite settings 表中，请保护 data/ 目录。
HEADSCALE_API_KEY=

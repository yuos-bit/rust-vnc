# RustVNC 配对后台（rv-server）专用环境文件。
#
# 首次运行 scripts/start-pairing-backend.ps1 / .sh 时会自动复制本文件并生成
# RV_ADMIN_TOKEN。本文件不应提交到 Git（已被 .gitignore 忽略）。

# ---- 必填 ----
# 管理台与管理 API 的 Bearer 令牌。请使用 32+ 字符随机值。
RV_ADMIN_TOKEN=change-me

# ---- 端口映射（宿主机） ----
# 默认只允许本机访问；对外部署时改为 0.0.0.0，并放在 TLS 反向代理之后。
PAIRING_BIND=127.0.0.1
PAIRING_PORT=8080

# 可选：公网地址（写入设置，仅用于展示/文档）
PUBLIC_URL=http://127.0.0.1:8080

# ---- 可选：Headscale 集成 ----
# 留空时配对后台仍可注册设备，但不会签发 tailnet 预授权密钥。
HEADSCALE_URL=
HEADSCALE_API_KEY=
HEADSCALE_USER=1
HEADSCALE_CONTROL_URL=
DERP_URL=

# ---- 可选：策略 ----
AGENT_PORT=21416
TOKEN_TTL_DAYS=30
# 在可信反向代理之后设为 1，才信任 X-Forwarded-For
RV_TRUST_PROXY=0

{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RustVNC",
  "version": "0.1.0",
  "identifier": "com.rustvnc.pc",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "RustVNC",
        "width": 1180,
        "height": 780,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "resizable": true,
        "transparent": true,
        "decorations": false,
        "shadow": true,
        "visible": true,
        "dragDropEnabled": false,
        "backgroundColor": "#00000000"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "category": "Utility",
    "shortDescription": "RustVNC — 异地组网远程控制",
    "longDescription": "RustVNC embeds a Tailscale-style mesh and a Rust remote-control engine to let phones and PCs control your computer without manual IP configuration.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ]
  }
}
